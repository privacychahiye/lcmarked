		public function fetch_pdf()
    {
        $this->output->set_content_type('application/json');

        // original URL provided
        $original_url = "http://storage.hrylabour.gov.in/uploads/factory_building_plan/factory_building_plan1742370755.pdf";

        // prefer HTTPS first, then fall back to original/HTTP
        $candidates = [
            // try HTTPS version (some servers redirect to 443)
            preg_replace('#^http:#i', 'https:', $original_url),
            $original_url
        ];

        // temp filename base
        $temp_base = sys_get_temp_dir() . '/factory_plan_' . time() . '_' . bin2hex(random_bytes(4)) . '.pdf';

        // configuration
        $connect_timeout = 10;   // seconds for connect
        $exec_timeout = 60;      // seconds for whole transfer
        $max_attempts = 2;       // retry attempts

        // helper to do a quick HEAD check (connectivity test)
        $check_connect = function($url) use ($connect_timeout) {
            $ch = curl_init($url);
            curl_setopt($ch, CURLOPT_NOBODY, true);
            curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
            curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, $connect_timeout);
            curl_setopt($ch, CURLOPT_TIMEOUT, $connect_timeout + 5);
            curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
            curl_setopt($ch, CURLOPT_HEADER, true);
            curl_setopt($ch, CURLOPT_USERAGENT, 'CI-PDF-Fetcher-Check/1.0');
            // allow both http and https
            curl_setopt($ch, CURLOPT_PROTOCOLS, CURLPROTO_HTTP | CURLPROTO_HTTPS);
            $res = curl_exec($ch);
            $err = curl_error($ch);
            $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            $ip = null;
            $primary_ip = curl_getinfo($ch, CURLINFO_PRIMARY_IP);
            if ($primary_ip) $ip = $primary_ip;
            curl_close($ch);
            return [
                'ok' => ($res !== false),
                'http_code' => $code,
                'curl_error' => $err,
                'ip' => $ip,
                'raw' => $res
            ];
        };

        // main downloader using cURL streaming to file
        $download_with_curl = function($url, $dest_path) use ($connect_timeout, $exec_timeout) {
            $ch = curl_init($url);
            $fp = @fopen($dest_path, 'w+');
            if ($fp === false) {
                return ['success' => false, 'error' => 'Failed to open temporary file for writing: ' . $dest_path];
            }
            curl_setopt($ch, CURLOPT_FILE, $fp);
            curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
            curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, $connect_timeout);
            curl_setopt($ch, CURLOPT_TIMEOUT, $exec_timeout);
            curl_setopt($ch, CURLOPT_FAILONERROR, true);
            curl_setopt($ch, CURLOPT_USERAGENT, 'CodeIgniter PDF Fetcher/1.0');
            curl_setopt($ch, CURLOPT_PROTOCOLS, CURLPROTO_HTTP | CURLPROTO_HTTPS);
            // optionally verify SSL — keep enabled for security
            curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, true);
            curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, 2);

            $exec_result = curl_exec($ch);
            $curl_errno = curl_errno($ch);
            $curl_error = curl_error($ch);
            $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            $primary_ip = curl_getinfo($ch, CURLINFO_PRIMARY_IP);

            curl_close($ch);
            fclose($fp);

            if ($exec_result === false) {
                // cleanup file
                @unlink($dest_path);
                return [
                    'success' => false,
                    'error' => $curl_error,
                    'errno' => $curl_errno,
                    'http_code' => $http_code,
                    'ip' => $primary_ip
                ];
            }

            // basic sanity: ensure file non-empty and looks like a PDF (starts with %PDF)
            $h = @fopen($dest_path, 'rb');
            $start = @fread($h, 4);
            @fclose($h);
            if ($start !== '%PDF') {
                // not a PDF — cleanup then return error
                @unlink($dest_path);
                return [
                    'success' => false,
                    'error' => 'Downloaded file did not start with %PDF (file may be HTML error page).',
                    'http_code' => $http_code
                ];
            }

            return [
                'success' => true,
                'path' => $dest_path,
                'http_code' => $http_code,
                'ip' => $primary_ip
            ];
        };

        // fopen fallback
        $download_with_fopen = function($url, $dest_path) use ($exec_timeout) {
            // stream context
            $ctx = stream_context_create([
                'http' => [
                    'method' => 'GET',
                    'header' => "User-Agent: CodeIgniter PDF Fetcher/1.0\r\n",
                    'timeout' => $exec_timeout
                ],
                'ssl' => [
                    'verify_peer' => true,
                    'verify_peer_name' => true
                ]
            ]);
            $data = @file_get_contents($url, false, $ctx);
            if ($data === false) {
                return ['success' => false, 'error' => 'file_get_contents failed (allow_url_fopen may be disabled or connection failed).'];
            }
            if (file_put_contents($dest_path, $data) === false) {
                return ['success' => false, 'error' => 'Failed to write to temporary file.'];
            }
            // verify PDF signature
            if (substr($data, 0, 4) !== '%PDF') {
                @unlink($dest_path);
                return ['success' => false, 'error' => 'Downloaded file did not start with %PDF (likely an HTML error page).'];
            }
            return ['success' => true, 'path' => $dest_path];
        };

        // try candidates
        $diagnostics = [];
        foreach ($candidates as $url) {
            // HEAD/connectivity check
            $head = $check_connect($url);
            $diagnostics[$url]['head'] = $head;

            if (!$head['ok']) {
                // connectivity failure - record and try next
                $diagnostics[$url]['note'] = 'HEAD check failed — skipping full download attempt.';
                continue;
            }

            // attempt download with retries
            $attempt = 0;
            while ($attempt < $max_attempts) {
                $attempt++;
                $temp_path = $temp_base . ($attempt > 1 ? "_r{$attempt}" : "");
                $diagnostics[$url]['attempts'][$attempt]['start_time'] = date('c');
                $res = $download_with_curl($url, $temp_path);
                $diagnostics[$url]['attempts'][$attempt]['result'] = $res;

                if (!empty($res['success'])) {
                    // success! return path
                    $this->output->set_output(json_encode([
                        'status' => 'success',
                        'source_url' => $url,
                        'temp_path' => $res['path'],
                        'http_code' => $res['http_code'] ?? null,
                        'ip' => $res['ip'] ?? null,
                        'diagnostics' => $diagnostics
                    ]));
                    return;
                }

                // if failure due to connection refused / couldn't connect, break and try next candidate
                if (stripos($res['error'] ?? '', 'Connection refused') !== false
                    || stripos($res['error'] ?? '', 'Could not resolve host') !== false
                    || isset($res['errno']) && $res['errno'] === 7 // CURLE_COULDNT_CONNECT
                ) {
                    $diagnostics[$url]['note'] = 'Connection-level error; will try next candidate or fallback.';
                    break;
                }

                // otherwise, retry once
            } // end attempts

            // cURL failed for candidate, try fopen fallback
            $temp_path_fopen = $temp_base . '_fopen';
            $fallback = $download_with_fopen($url, $temp_path_fopen);
            $diagnostics[$url]['fopen_fallback'] = $fallback;
            if (!empty($fallback['success'])) {
                $this->output->set_output(json_encode([
                    'status' => 'success',
                    'source_url' => $url,
                    'temp_path' => $fallback['path'],
                    'diagnostics' => $diagnostics
                ]));
                return;
            }

            // else continue to next candidate
        } // end candidates loop

        // If we reached here: all attempts failed. Return diagnostics and suggestions.
        $message = 'Failed to fetch PDF: connection/download attempts failed. See diagnostics for details.';
        $this->output->set_output(json_encode([
            'status' => 'error',
            'message' => $message,
            'original_url' => $original_url,
            'diagnostics' => $diagnostics,
            'hints' => [
                'Check that your server can make outbound connections (port 80 and 443) to storage.hrylabour.gov.in.',
                'From your server run: curl -v https://storage.hrylabour.gov.in/... or curl -v http://storage.hrylabour.gov.in/... to see what fails.',
                'If you see "Connection refused" or "Unable to connect", firewall/host or remote server may block connections.',
                'If DNS resolution fails, ensure the server has working DNS or try resolving with: nslookup storage.hrylabour.gov.in or dig.',
                'If allow_url_fopen is disabled, enable it or rely on cURL; ensure PHP has curl extension installed.',
                'If the remote server requires a client IP whitelist or specific headers, coordinate with the remote host.'
            ]
        ]));
    }
