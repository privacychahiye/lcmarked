		public function cess() {

			$complaint_id = $this->uri->segment(4);
			if(empty($complaint_id)) {
				redirect('404');
			}

			$data['complaint_id'] = $complaint_id;
			$data['buildingPlan'] = $this->factorybuilding_model->viewapplication($complaint_id);

			if($data['buildingPlan']['final_status']!='2') {
				redirect('department/factorybuilding/viewdetail/'.$complaint_id);
			}
			
			$this->db->where(array(
				'complaint_id' => $complaint_id,
				'factory_reg_id' => $data['buildingPlan']['factory_reg_id'],
				'plant' => $data['buildingPlan']['plant'],
			));
			$data['cess_docs'] = $this->db->select('*')->from('labour_factorybuilding_cess_docs')->get()->row_array();

			if ($_SERVER['REQUEST_METHOD'] == 'POST') {
				if($_SESSION['uniqToken'] != $this->input->post('uniqToken')){
					redirect("404");
				}
				$this->form_validation->set_rules('document_upload', 'Upload Document', 'trim|required');
				$this->form_validation->set_rules('const_cost', 'Construction Cost', 'trim|required|numeric|greater_than[0]');
				if ($this->form_validation->run()) {

					$verifyassigntoetail = getOfficerNameByJobid($_SESSION['department']['job_id']);
					$set_data = array(
						'complaint_id' => $complaint_id,
						'factory_reg_id' => $data['buildingPlan']['factory_reg_id'],
						'plant' => $data['buildingPlan']['plant'],
						'officer_id' => $_SESSION['department']['id'],
						'officer_name' => $verifyassigntoetail,
						'uploaded_document' => $this->input->post('document_upload'),
						'const_cost' => $this->input->post('const_cost'),
					);
					$this->db->insert('labour_factorybuilding_cess_docs',$set_data);

					$this->session->set_flashdata('msg', 'Successfully uploaded document...!');
					redirect('department/factorybuilding/viewdetail/'.$complaint_id);

				}
			}

			$factory_id = $data['buildingPlan']['factory_reg_id'];
			$data['factory_id'] = $factory_id;
			$data['factory_info'] = $this->factorybuilding_model->getFactoryDetail($factory_id);

			$data['checklist']	= $this->factorybuilding_model->getChecklist($complaint_id);

			$data['uniqToken'] 	= randomPassword(5);
            $this->session->set_userdata("uniqToken",$data['uniqToken']); // Security check

			$data['content'] = "buildingplan/cess";
			$this->load->view('department_theme/template', $data);
		}

		public function report(){

			$srch['district'] = $this->input->get("district");
			$srch['keyword'] = $this->input->get("keyword");
			$srch['date'] = $this->input->get("date");
			$date = explode('-',$this->input->get("date"));
			if(!empty(@$date[0])) {
				$srch['sdate'] =  date('Y-m-d',strtotime(@$date[0]));
			}
			if(!empty(@$date[0])) {
				$srch['edate'] =  date('Y-m-d',strtotime(@$date[1]));
			}

            $data['total_applications'] = $this->factorybuilding_model->get_applications_count($srch);
            
            $config["base_url"] 			=	base_url()."department/factorybuilding/report?".http_build_query($srch);
            $config["total_rows"] 			= 	 $data['total_applications'];
            $config["per_page"] 			= 	10;
            $config['num_links'] 			= 	5;
            $config['use_page_numbers'] 	= 	false;
            $config['page_query_string'] 	= 	true;
            $config['cur_tag_open'] 		= 	'<li class="active" ><a href="#" >';
            $config['cur_tag_close'] 		= 	'</a></li>';
            $config['next_link'] 			=	'>';
            $config['next_tag_open'] 		= 	'<li>';
            $config['next_tag_close'] 		= 	'</li>';
            $config['prev_link'] 			= 	'<';
            $config['prev_tag_open'] 		= 	'<li>';
            $config['prev_tag_close'] 		=	'</li>';
            $config['num_tag_open'] 		= 	'<li class="page">';
            $config['num_tag_close'] 		= 	'</li>';
            $config['last_link'] 			= 	'Last »';
            $config['last_tag_open'] 		= 	'<li>';
            $config['last_tag_close'] 		=	'</li>';
            $config['first_link'] 			= 	'« First';
            $config['first_tag_open'] 		= 	'<li>';
            $config['first_tag_close'] 		= 	'</li>';
            $this->pagination->initialize($config);
            $data['pagination'] 			=	 $this->pagination->create_links();			
            if($this->input->get('per_page')){
                $page 						=	$this->input->get('per_page');  
                $data['countpage'] 			=	$page;
            }
            else{
                $page 						=	0;
                $data['countpage'] 			=	0;
            }

            $result = $this->factorybuilding_model->get_applications($srch,$config['per_page'],$page);

            $data['search'] = $srch;
            $data['applications'] = $result;

            $data['content'] = 'buildingplan/mis_view';
            $this->load->view('department_theme/template',$data);


		}
