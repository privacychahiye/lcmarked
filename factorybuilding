		/*
			*	AddedDate: 12 April 2018;
			*	AddedBy: Sonia
			*	FunctionName:  generateRejLetter
			*	Purpose: Generate Rejection Letter for factory building plan
		*/
		public function generateRejLetter(){
			$planid	 					=		$this->uri->segment(4);
			$rejections 				=		$this->factorybuilding_model->countRejections($planid);
			$dept_officer				=		$this->session->userdata("department");			
			$admin_privileges 			=		explode(",",str_replace("-","",$dept_officer['privileges'][12]));				
			$privileges	 				=		$this->factorybuilding_model->getPrivileges($admin_privileges,$dept_officer['job_id']);
			$plandetail	 				=		$this->factorybuilding_model->getPlandetail($planid);
			$factInfo					=		$this->factory_model->getFactoryInfoByID($plandetail[0]['factory_reg_id']);
			
			$data['showLink'] 			= 		"";						
			$data['adminPrivilege']		=		$admin_privileges;
			$data['issueRej']			=		"false";
			if(in_array(146,$admin_privileges)){				
				if(in_array(147,$admin_privileges)){					
					if($factInfo['app_divider'] == 2){
						$data['issueRej']	=	"true";						
					}					
				}
				else{
					$data['issueRej']		=	"true";
				}
			}
			
			if(count($rejections) > 0){
				/**START: CODE TO CHECK THE APPLICATION STATUS FROM FACTORY LICENCE TABLE i.e. TB_PRE.FACTLI**/
				$data['rejLetter']  		=		$this->factorybuilding_model->getLatestRejection($planid);				
				$data['rej_id']				=		$data['rejLetter']['id'];
				$objDetail					=		$this->factorybuilding_model->getRejectionById($data['rej_id']);
				$data['letterContent']		=		$objDetail['rej_letter'];
				$app_divider			=	"";
				$appdivider			=	"";
				if(isset($dept_officer['app_divider'][12])){
					$app_divider 		=	str_replace('-','',$dept_officer['app_divider'][12]);
					$appdivider 			=	explode(',',$app_divider);				
				}
				$getstatus = $this->factorybuilding_model->getlateststatus($planid);				
				if($getstatus == 139 && $objDetail['rej_status'] == '0' && (!empty($appdivider) && in_array($factInfo['app_divider'] , $appdivider))){
					$data['showLink'] = true;
				}
			}
			else{
				//Get Factory Details to be printed on the objection letter
				$factInfo['villageName'] 	=		$factInfo['villages_name'] !="" ? $factInfo['villages_name'] : "N/A";
				$factInfo['indRegion']   	=		$factInfo['industrial_state'] !="" ? $factInfo['industrial_state'] : "N/A";
				$factInfo['indState']		=		$factInfo['industrial_region'] !="" ? $factInfo['industrial_region'] : "N/A";
				$factInfo['plotFact']		=		$factInfo['factory_reg_u_plot'] !="" ? $factInfo['factory_reg_u_plot'] : "N/A";
				
				$fullName					=		"&nbsp;&nbsp;&nbsp; ".$factInfo['factory_reg_o_name']." <br />&nbsp;&nbsp;&nbsp; M/s ".$factInfo['factory_reg_u_name']." <br /><br />";
				$fullAdd					=		"&nbsp;&nbsp;&nbsp; ".$factInfo['factory_reg_u_address'].",&nbsp;Plot no.:".$factInfo['plotFact']."<br /> &nbsp;&nbsp;&nbsp;Industrial Estate: ".$factInfo['indRegion'].",&nbsp;Industrial Region:".$factInfo['indState']."<br /> &nbsp;&nbsp;&nbsp;Village: ".$factInfo['villageName'].",&nbsp;Tehsil:".$factInfo['tehsil_name']."<br /> &nbsp;&nbsp;&nbsp;District: ".$factInfo['distt_name'].",&nbsp;State:Haryana<br />";
				
				// Generate letter content
				$NUM = 1;
				$value ="<br/>From<br/>The Chief Inspector of Factories<br />Haryana,Chandigarh.<br/>";
				$value .="TO <br/><br /><br /> ".$fullName."".$fullAdd."<br />";
				
				$value 					.= 		"You have not complied with the observation till now therefore your application is rejected.<br /><br /><br /><br />";
				
				$data['showLink']			=		false;
				$data['letterSubmit']		=		1;
				$data['rej_id']				=		"";
				$data['letterContent']		=		$value;	
			}
			$adminDetails					=		$this->session->userdata("department");
			$data['regName']				=		$factInfo['factory_reg_u_name'];
			$data['planid']					=		$this->uri->segment(4);
			$data['factory_reg_id']			=		$plandetail[0]['factory_reg_id'];
			$data['admin_id']				=		$adminDetails['officer_id'];
			$data['content']				=		"buildingplan/rejLetter";			
			$this->load->view("department_theme/template",$data);
		}
		
