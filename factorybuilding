		public function submitRejLetter(){
			$adminDetails				=		$this->session->userdata("department");
			$data['admin_id']			=		$adminDetails['officer_id'];
			$dept_officer				=		$this->factorybuilding_model->getOfficerByID($data['admin_id']);
			$app_mark 					=		 0;
			$rej_id						=		$this->input->post('rej_id');
			$planid						=		$this->input->post("planid"); 
			// Incase of submit letter
			if(isset($_POST['submitLetter'])){
				$obj_letter				=		htmlentities($this->input->post("letter"));
				//if objection already present for the same objection id then edit the same
				if($rej_id != ""){
					$data				=		array(
					"factory_reg_id"	=>		$this->input->post("reg_id"),
					"plan_id"			=>		$this->input->post("planid"),
					"rej_letter"		=>		$obj_letter,
