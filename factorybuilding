					);
					$res 				=		$this->factorybuilding_model->editRejection($data,$rej_id); // Edit objection already created
					if($res){
						// Redirect to scruitny page after editing objection
						$this->session->set_flashdata('msg','Successfully Submitted !');  
						redirect("department/factorybuilding/viewdetail/".$planid);
					}
